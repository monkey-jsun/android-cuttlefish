git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "gfxstream",
    commit = "765baff3f024d0b2dea02288f5ee0cc94886224d",
    remote = "https://github.com/google/gfxstream.git",
    patch_strip = 1,
    patches = [
        "@//build_external/gfxstream:PATCH.gfxstream.build_variables.patch",
        # PowerVR reports FORMAT_NOT_SUPPORTED for images it can actually create
        # and export; fall back to the unchained query.  Drop when b/400999642
        # or an Imagination driver fix lands.
        "@//build_external/gfxstream:PATCH.gfxstream.pvr_external_format_query.patch",
        # Fix GLES1 fixed-function matrices on GLES/core hosts (PowerVR); see the patch.
        "@//build_external/gfxstream:PATCH.gfxstream.gles1_matrix.patch",
    ],
)
