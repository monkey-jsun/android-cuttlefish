load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Modeled after Android.bp from AOSP android16-qpr2-release.
# This fork (platform/external/ms-tpm-20-ref) has a different layout from
# Microsoft's upstream v1.83r1: sources are in tpm/src/ subdirectories,
# includes are in tpm/include/Ossl/ (not tpm/cryptolibs/Ossl/include/),
# there is no TpmConfiguration/ directory, and Platform_fp.h exists.

_COPTS = [
    "-std=gnu11",
    "-Werror",
    "-Wall",
    "-Wformat-security",
    "-fstack-protector-all",
    "-fPIC",
    # Suppress warnings matching Android.bp cflags
    "-Wno-cast-function-type-mismatch",
    "-Wno-empty-body",
    "-Wno-logical-op-parentheses",
    "-Wno-missing-field-initializers",
    "-Wno-typedef-redefinition",
    "-Wno-unused-parameter",
]

_DEFINES = [
    "HASH_LIB=Ossl",
    "SYM_LIB=Ossl",
    "MATH_LIB=Ossl",
    # BoringSSL has no Camellia — match Android.bp
    "ALG_CAMELLIA=ALG_NO",
]

cc_library(
    name = "platform_headers",
    hdrs = glob(["TPMCmd/Platform/**/*.h"]),
    includes = [
        "TPMCmd/Platform/include",
        "TPMCmd/Platform/include/prototypes",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "simulator_headers",
    hdrs = glob(["TPMCmd/Simulator/**/*.h"]),
    includes = [
        "TPMCmd/Simulator/include",
        "TPMCmd/Simulator/include/prototypes",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tpm_headers",
    hdrs = glob([
        "TPMCmd/tpm/include/**/*.h",
    ]),
    includes = [
        "TPMCmd/tpm/include",
        "TPMCmd/tpm/include/Ossl",
        "TPMCmd/tpm/include/prototypes",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "platform",
    srcs = glob(["TPMCmd/Platform/src/*.c"]),
    copts = _COPTS,
    defines = _DEFINES,
    visibility = [
        "@//cuttlefish/host/commands/secure_env:__subpackages__",
    ],
    deps = [
        ":platform_headers",
        ":tpm_headers",
    ],
)

cc_library(
    name = "tpm",
    srcs = glob(
        [
            "TPMCmd/tpm/src/command/**/*.c",
            "TPMCmd/tpm/src/crypt/*.c",
            "TPMCmd/tpm/src/crypt/ossl/*.c",
            "TPMCmd/tpm/src/events/*.c",
            "TPMCmd/tpm/src/main/*.c",
            "TPMCmd/tpm/src/subsystem/*.c",
            "TPMCmd/tpm/src/support/*.c",
            "TPMCmd/tpm/src/X509/*.c",
        ],
        exclude = [
            "TPMCmd/tpm/src/crypt/ltc/*.c",
            "TPMCmd/tpm/src/crypt/wolf/*.c",
        ],
    ),
    copts = _COPTS,
    defines = _DEFINES,
    visibility = [
        "@//cuttlefish/host/commands/secure_env:__subpackages__",
    ],
    deps = [
        ":platform_headers",
        ":tpm_headers",
        "@boringssl//:crypto",
        "@boringssl//:ssl",
    ],
)

cc_library(
    name = "simulator_lib",
    srcs = [
        "TPMCmd/Simulator/src/TPMCmdp.c",
        "TPMCmd/Simulator/src/TcpServer.c",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    visibility = [
        "@//cuttlefish/host/commands/secure_env:__subpackages__",
    ],
    deps = [
        ":platform_headers",
        ":simulator_headers",
        ":tpm_headers",
    ],
)

cc_binary(
    name = "simulator",
    srcs = [
        "TPMCmd/Simulator/src/TPMCmds.c",
    ],
    copts = _COPTS,
    defines = _DEFINES,
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,-z,noexecstack",
        "-Wl,-z,now",
        "-Wl,-z,relro",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":platform",
        ":simulator_headers",
        ":simulator_lib",
        ":tpm",
        "@boringssl//:crypto",
    ],
)
