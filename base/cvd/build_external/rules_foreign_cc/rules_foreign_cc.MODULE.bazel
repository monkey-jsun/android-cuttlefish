# riscv64: rules_foreign_cc does not recognize riscv64 as a supported CPU,
# its bundled pkg-config 0.29.2 config.guess (2015) cannot detect riscv64,
# and cmake bootstrap from source is prohibitively slow under qemu-user.
# Patches add riscv64 to the platform list, pass --build explicitly to
# pkg-config's configure, and provide a prebuilt cmake 3.31.8.
single_version_override(
    module_name = "rules_foreign_cc",
    patches = [
        "@//build_external/rules_foreign_cc:riscv64_platform.patch",
        "@//build_external/rules_foreign_cc:riscv64_pkgconfig.patch",
        "@//build_external/rules_foreign_cc:riscv64_cmake_prebuilt.patch",
    ],
    patch_strip = 1,
)
